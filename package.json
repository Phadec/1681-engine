{
  "name": "lantern-engine",
  "version": "0.3.0",
  "description": "A 2D game engine on PixiJS 8 for any art style: scenes and a fast ECS, a fixed-step loop, asset loading, Tiled maps, sprite animation, input actions, camera follow, audio and deterministic, server-replayable movement, plus Dither, an optional pixel-art module (pixel-perfect effects, dithered lighting).",
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lantern-engine.js"
    },
    "./pixel": {
      "types": "./dist/types/pixel/index.d.ts",
      "import": "./dist/pixel.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run clean && vite build && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node scripts/test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check",
    "bench": "node --expose-gc --import tsx bench/ecs.bench.ts",
    "example:server": "tsx examples/multiplayer/server.ts",
    "docs:examples": "node scripts/build-examples.mjs",
    "docs:dev": "npm run docs:prepare && vitepress dev docs",
    "docs:build": "npm run docs:prepare && npm run docs:examples && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:prepare": "typedoc && node -e \"require('fs').copyFileSync('CHANGELOG.md','docs/changelog.md')\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "pixi.js": "^8.21.0",
    "tsx": "^4.20.5",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitepress": "^1.6.4",
    "ws": "^8.22.0"
  },
  "license": "MIT",
  "keywords": [
    "game-engine",
    "2d",
    "pixijs",
    "ecs",
    "tiled",
    "pixel-art",
    "gamedev",
    "multiplayer",
    "typescript"
  ],
  "sideEffects": [
    "./dist/*.js"
  ],
  "module": "./dist/lantern-engine.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "pixi.js": "^8.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Phadec/lantern-engine.git"
  },
  "homepage": "https://phadec.github.io/lantern-engine/",
  "bugs": {
    "url": "https://github.com/Phadec/lantern-engine/issues"
  },
  "author": "Phadec"
}
