{
  "name": "1681-engine",
  "version": "0.6.5",
  "description": "A 2D game engine on PixiJS 8 for any art style: scenes and a fast ECS, a fixed-step loop, asset loading, Tiled maps, sprite animation, input actions, camera follow, audio and deterministic, server-replayable movement, plus Dither, an optional pixel-art module (pixel-perfect effects, dithered lighting).",
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/1681-engine.js"
    },
    "./pixel": {
      "types": "./dist/types/pixel/index.d.ts",
      "import": "./dist/pixel.js"
    },
    "./ui": {
      "types": "./dist/types/ui/index.d.ts",
      "import": "./dist/ui.js"
    },
    "./postfx": {
      "types": "./dist/types/postfx/index.d.ts",
      "import": "./dist/postfx.js"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react.js"
    },
    "./pixel/tone": {
      "types": "./dist/types/pixel/pixelTone.d.ts",
      "import": "./dist/pixel/pixelTone.js"
    },
    "./pixel/paint": {
      "types": "./dist/types/pixel/pixelPaint.d.ts",
      "import": "./dist/pixel/pixelPaint.js"
    },
    "./updates": {
      "import": {
        "types": "./dist/types/updates/index.d.ts",
        "default": "./dist/updates.js"
      },
      "require": {
        "types": "./dist/cjs/updates/index.d.ts",
        "default": "./dist/cjs/updates/index.js"
      }
    },
    "./electron": {
      "import": {
        "types": "./dist/types/electron/index.d.ts",
        "default": "./dist/electron.js"
      },
      "require": {
        "types": "./dist/cjs/electron/index.d.ts",
        "default": "./dist/cjs/electron/index.js"
      }
    },
    "./mobile": {
      "types": "./dist/types/mobile/index.d.ts",
      "import": "./dist/mobile.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run clean && vite build && tsc -p tsconfig.build.json && node scripts/fix-dts-extensions.mjs && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node scripts/test.mjs",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check",
    "bench": "node --expose-gc --import tsx bench/ecs.bench.ts",
    "example:server": "tsx examples/multiplayer/server.ts",
    "example:lobby": "tsx examples/lobby/server.ts",
    "docs:examples": "node scripts/build-examples.mjs",
    "docs:dev": "npm run docs:prepare && vitepress dev docs",
    "docs:build": "npm run docs:prepare && npm run docs:examples && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:prepare": "typedoc && node -e \"require('fs').copyFileSync('CHANGELOG.md','docs/changelog.md')\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitest/browser-playwright": "^4.1.11",
    "pixi.js": "^8.21.0",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.20.5",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11",
    "ws": "^8.22.0"
  },
  "license": "MIT",
  "keywords": [
    "game-engine",
    "2d",
    "pixijs",
    "ecs",
    "tiled",
    "pixel-art",
    "gamedev",
    "multiplayer",
    "typescript"
  ],
  "sideEffects": false,
  "module": "./dist/1681-engine.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "pixi.js": "^8.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "electron": ">=28.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "electron": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Phadec/1681-engine.git"
  },
  "homepage": "https://phadec.github.io/1681-engine/",
  "bugs": {
    "url": "https://github.com/Phadec/1681-engine/issues"
  },
  "author": "Phadec"
}
