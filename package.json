{
  "name": "lantern-engine",
  "version": "0.2.0",
  "description": "A 2D game engine on PixiJS 8 for any art style: scenes and a fast ECS, a fixed-step loop, asset loading, Tiled maps, sprite animation, input actions, camera follow, audio and deterministic, server-replayable movement, plus Dither, an optional pixel-art module (pixel-perfect effects, dithered lighting).",
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lantern-engine.js"
    },
    "./pixel": {
      "types": "./dist/types/pixel/index.d.ts",
      "import": "./dist/pixel.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run clean && vite build && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check",
    "bench": "node --expose-gc --import tsx bench/ecs.bench.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "pixi.js": "^8.21.0"
  },
  "license": "MIT",
  "keywords": [
    "game-engine",
    "2d",
    "pixijs",
    "ecs",
    "tiled",
    "pixel-art",
    "gamedev",
    "multiplayer",
    "typescript"
  ],
  "sideEffects": [
    "./dist/*.js"
  ],
  "module": "./dist/lantern-engine.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "pixi.js": "^8.6.0"
  }
}
